# ==============================================================================
# AI Video Editor - Environment Variables
# ==============================================================================

# 1. Google Gemini API Key (Free tier available at https://aistudio.google.com/app/apikey)
# Used for Gemini 2.0 Flash Studio AI Voices & Khmer Scriptwriting
GEMINI_API_KEY=
VITE_GEMINI_API_KEY=

# 2. ElevenLabs API Key (https://elevenlabs.io)
# Used for 100% human-grade Voice Cloning & Multilingual Speech Synthesis
ELEVENLABS_API_KEY=

# 3. Server Configuration
PORT=3001
HOST=127.0.0.1
STORAGE_PATH=./storage

# 4. Native Tools
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# 5. Optional Integrations
OPENAI_API_KEY=
COMFYUI_URL=http://127.0.0.1:8188
