{
  "name": "ai-video-editor-workspace",
  "version": "1.0.0",
  "private": true,
  "description": "AI Video Editor Monorepo with separated Frontend, Backend, and Desktop",
  "type": "module",
  "workspaces": [
    "frontend",
    "backend",
    "desktop"
  ],
  "scripts": {
    "dev": "node scripts/start-dev.mjs",
    "dev:all": "node scripts/start-dev.mjs",
    "dev:frontend": "npm run dev --prefix frontend",
    "dev:backend": "npm run dev --prefix backend",
    "dev:xtts": "python backend/python/xtts_server.py",
    "desktop": "npm run start --prefix desktop",
    "build": "npm run build --prefix frontend",
    "preview": "npm run preview --prefix frontend",
    "lint": "npm run lint --prefix frontend",
    "format": "npm run format --prefix frontend",
    "format:check": "npm run format:check --prefix frontend",
    "typecheck": "npm run typecheck --prefix frontend",
    "check": "npm run check --prefix frontend"
  },
  "dependencies": {
    "@diffusionstudio/vits-web": "^1.0.3",
    "@ffmpeg/core": "^0.12.10",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "@heyputer/puter.js": "^2.6.2",
    "@huggingface/transformers": "^3.8.1",
    "@libav.js/variant-webcodecs": "^6.9.8",
    "@mediabunny/aac-encoder": "^1.50.8",
    "@mediapipe/tasks-vision": "^1.0.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@phosphor-icons/react": "^2.1.10",
    "fflate": "^0.8.3",
    "hangul-romanization": "^1.0.1",
    "kokoro-js": "^1.2.1",
    "mediabunny": "^1.50.8",
    "onnxruntime-web": "^1.27.0",
    "onnxruntime-web-migan": "npm:onnxruntime-web@^1.16.3",
    "pinyin-pro": "^3.27.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-react": "^5.0.4",
    "eslint": "^10.7.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "prettier": "^3.9.5",
    "typescript": "^7.0.2",
    "vite": "^6.4.2"
  },
  "overrides": {
    "tar": "7.5.21"
  }
}
