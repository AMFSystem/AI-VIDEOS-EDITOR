{
  "name": "ai-video-editor-workspace",
  "version": "1.0.0",
  "private": true,
  "description": "AI Video Editor Monorepo with separated Frontend, Backend, and Desktop",
  "type": "module",
  "workspaces": [
    "frontend",
    "backend",
    "desktop"
  ],
  "scripts": {
    "dev": "node scripts/start-dev.mjs",
    "dev:all": "node scripts/start-dev.mjs",
    "stop": "node scripts/stop-dev.mjs",
    "restart": "node scripts/stop-dev.mjs && node scripts/start-dev.mjs",
    "dev:frontend": "npm run dev --prefix frontend",
    "dev:backend": "npm run dev --prefix backend",
    "dev:aiclone:backend": "cd backend/ai_clone && uvicorn app.main:app --host 0.0.0.0 --port 8000",
    "dev:pyvideotrans": "python backend/python/pyvideotrans_runner.py",
    "desktop": "npm run start --prefix desktop",
    "desktop:build": "npm run build --prefix frontend && npm run build --prefix desktop",
    "desktop:build:mac": "npm run build --prefix frontend && npm run build:mac --prefix desktop",
    "desktop:build:win": "npm run build --prefix frontend && npm run build:win --prefix desktop",
    "build": "npm run build --prefix frontend",
    "preview": "npm run preview --prefix frontend",
    "lint": "npm run lint --prefix frontend",
    "format": "npm run format --prefix frontend",
    "format:check": "npm run format:check --prefix frontend",
    "typecheck": "npm run typecheck --prefix frontend",
    "check": "npm run check --prefix frontend"
  },
  "devDependencies": {
    "electron-builder": "^26.18.0",
    "prettier": "^3.9.5"
  },
  "overrides": {
    "tar": "7.5.21"
  }
}
